{
    "name": "@yuuues/yuuu-ui",
    "version": "0.5.0",
    "description": "Design tokens and base stylesheet of the yuuu suite as importable CSS: dark mode, tested contrast tiers (AAA 7:1 for reading text, AA 4.5:1 for secondary text, 3:1 for non-text), no external resources",
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yuuues/yuuu-ui.git"
    },
    "files": [
        "public/css/tailwind.css",
        "public/css/tokens.css",
        "public/css/yuuu-base.css"
    ],
    "exports": {
        "./tokens.css": "./public/css/tokens.css",
        "./base.css": "./public/css/yuuu-base.css",
        "./tailwind.css": "./public/css/tailwind.css",
        "./package.json": "./package.json"
    },
    "sideEffects": [
        "*.css"
    ]
}
